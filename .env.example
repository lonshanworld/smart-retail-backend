# This file provides environment variables for local development.
# Copy this file to .env and replace the placeholders with your actual credentials.

# Your PostgreSQL connection string (e.g., from Neon or a local instance)
DATABASE_URL="postgres://user:password@host:port/dbname"

# A strong, secret key for signing JSON Web Tokens (JWTs).
# You can generate one using: openssl rand -base64 32
JWT_SECRET="your-super-secret-key"

# Set to true when this backend should not accept cloud sync traffic.
LOCAL_STORAGE_ONLY=false

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=*
# Required for first-admin initialization and Gemini/AI integrations.
INIT_TOKEN="replace-with-a-long-random-initialization-token"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""

# Image/file storage. Use "cloudinary" or "minio".
STORAGE_PROVIDER="minio"
STORAGE_MAX_UPLOAD_BYTES=10485760

# Cloudinary storage (required when STORAGE_PROVIDER=cloudinary).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="smart-retail"

# MinIO storage (required when STORAGE_PROVIDER=minio).
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="smart-retail"
MINIO_REGION="us-east-1"
MINIO_PUBLIC_URL=""
MINIO_SECURE=false
